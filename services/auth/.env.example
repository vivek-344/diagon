APP_NAME=diagon-auth
APP_ENV=development
APP_VERSION=dev
GRPC_PORT=50051
SHUTDOWN_TIMEOUT=10s

DB_HOST=localhost
DB_PORT=5432
DB_USER=auth_user
DB_PASSWORD=your_db_password
DB_NAME=diagon
DB_SEARCH_PATH=auth
DB_SSLMODE=disable

JWT_SECRET=your_jwt_secret
JWT_ACCESS_DURATION=15m
JWT_REFRESH_DURATION=168h